<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aidog_interfaces</name>
  <version>0.14.1</version>
  <description>Contains message and service definitions used by the AIDog project.</description>

  <maintainer email="noladonato@gmail.com">Nola Donato</maintainer>

  <license>Apache License 2.0</license>

  <author email="noladonato@gmail.com">Nola Donato</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>ros2cli</depend>
  <depend>ros2web_interfaces</depend>
  <build_depend>sensor_msgs</build_depend>
  
  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>